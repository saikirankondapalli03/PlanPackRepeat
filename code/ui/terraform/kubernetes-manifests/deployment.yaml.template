# Kubernetes Deployment Template for Spring Boot Application
# This is a template file - update values as needed
# Note: The Terraform configuration handles this automatically, but this can be used for manual deployments

apiVersion: apps/v1
kind: Deployment
metadata:
  name: spring-boot-app
  namespace: spring-boot-app
  labels:
    app: spring-boot-app
    environment: ${ENVIRONMENT}
spec:
  replicas: ${REPLICAS}
  selector:
    matchLabels:
      app: spring-boot-app
  template:
    metadata:
      labels:
        app: spring-boot-app
        environment: ${ENVIRONMENT}
    spec:
      containers:
      - name: spring-boot-app
        image: ${IMAGE}:${IMAGE_TAG}
        ports:
        - containerPort: 8080
          name: http
        env:
        - name: SPRING_PROFILES_ACTIVE
          value: "${SPRING_PROFILE}"
        - name: SERVER_PORT
          value: "8080"
        # Add additional environment variables here
        # - name: SPRING_DATASOURCE_URL
        #   value: "jdbc:postgresql://db.example.com:5432/mydb"
        resources:
          requests:
            cpu: 500m
            memory: 512Mi
          limits:
            cpu: 1000m
            memory: 1Gi
        livenessProbe:
          httpGet:
            path: /actuator/health
            port: 8080
          initialDelaySeconds: 60
          periodSeconds: 30
          timeoutSeconds: 5
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /actuator/health
            port: 8080
          initialDelaySeconds: 30
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 3

---
apiVersion: v1
kind: Service
metadata:
  name: spring-boot-app
  namespace: spring-boot-app
  labels:
    app: spring-boot-app
    environment: ${ENVIRONMENT}
spec:
  selector:
    app: spring-boot-app
  ports:
  - port: 80
    targetPort: 8080
    protocol: TCP
    name: http
  type: ClusterIP

---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: spring-boot-app-ingress
  namespace: spring-boot-app
  annotations:
    kubernetes.io/ingress.class: nginx
    # cert-manager.io/cluster-issuer: letsencrypt-prod  # Uncomment if using cert-manager
spec:
  ingressClassName: nginx
  tls:
  - hosts:
    - ${INGRESS_HOST}
    secretName: spring-boot-app-tls
  rules:
  - host: ${INGRESS_HOST}
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: spring-boot-app
            port:
              number: 80
