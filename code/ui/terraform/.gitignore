# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which might contain sensitive data
*.tfvars
!terraform.tfvars.example
!environments/*.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files (optional - some teams prefer to commit these)
# .terraform.lock.hcl

# Ignore backup files
*.backup
*.bak

# Ignore plan files
*.tfplan

# Ignore environment files
.env
.env.local
